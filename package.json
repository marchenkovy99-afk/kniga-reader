{
  "name": "kniga-reader",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "npm run build:reader && node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "build:reader": "vite build --config reader/vite.config.js",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check reader/src/main.js && node --check reader/src/importer.js && node --check reader/src/pagination.js && node --check reader/src/cloud.js && tsc --noEmit"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "js-sha256": "0.11.1",
    "next": "16.4.3",
    "page-flip": "2.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "9.39.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "$fflate",
    "undici": "7.30.1"
  }
}
